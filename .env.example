# Keymakers public website — local notes only.
# Copy to .env.local. Never commit .env, .env.local, keys, or credential files.
# Live webhook and Givebutter IDs used by the static pages live in
# assets/js/keymakers-config.js (frontend config, not admin secrets).
# This file lists environment names and safe placeholders only.

NEXT_PUBLIC_N8N_WEBHOOK_DOMAIN=https://YOUR-N8N-HOST.example
NEXT_PUBLIC_GIVEBUTTER_ACCOUNT_ID=YOUR_GIVEBUTTER_ACCOUNT_ID
NEXT_PUBLIC_GIVEBUTTER_CAMPAIGN=YOUR_GIVEBUTTER_CAMPAIGN_SLUG
