# Keymakers public website — local notes only.
# Copy to .env.local. Never commit .env, .env.local, keys, or credential files.
# Live webhook and Givebutter IDs used by the static pages live in
# assets/js/keymakers-config.js (frontend config, not admin secrets).

NEXT_PUBLIC_N8N_WEBHOOK_DOMAIN=https://primary-production-a33d.up.railway.app

# Givebutter widget configuration (replace with values from Givebutter Dashboard)
NEXT_PUBLIC_GIVEBUTTER_ACCOUNT_ID=YOUR_EXACT_ACCOUNT_CODE_FROM_SCREENSHOT
NEXT_PUBLIC_GIVEBUTTER_CAMPAIGN=keymakers-campaign
