# Keymakers Community Circle — HumHub pilot environment.
# Copy to `.env` (gitignored) and fill in. Never commit the copy.
# Generate secrets with: ./scripts/generate-secrets.sh

# --- Address ---------------------------------------------------------------
# Local pilot: https://localhost (self-signed certificate from the built-in Caddy).
# Keep host ports 80/443: HumHub's live push (Mercure) calls the base URL from inside
# the container, where Caddy listens on 443, so a different host port breaks it.
# Production: https://community.<existing-keymakers-domain>, a subdomain of the existing
# Keymakers domain. The exact hostname is not confirmed. Set it only after the
# cost-control deployment gate in docs/deployment.md is passed. No new domain.
HUMHUB_SERVER_NAME=https://localhost
HUMHUB_HTTP_PORT=80
HUMHUB_HTTPS_PORT=443

# --- Database (MariaDB) ----------------------------------------------------
HUMHUB_DB_NAME=humhub
HUMHUB_DB_USER=humhub
HUMHUB_DB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# --- Mail ------------------------------------------------------------------
# Not configured by env. scripts/set-mail-no-delivery.sh sets HumHub to
# "No Delivery (save as file)". Keep it until WVF confirms the EXISTING WVF
# mailbox supports the SMTP or relay settings HumHub needs (invitations and
# password recovery). SMTP credentials go in the HumHub admin UI, never here.

# --- Theme footer links (https:// or mailto: only; empty shows "coming soon") -
KEYMAKERS_RETURN_URL=https://keymakers.womensventurefund.org/
KEYMAKERS_RULES_URL=
KEYMAKERS_PRIVACY_URL=https://keymakers.womensventurefund.org/privacy.html
KEYMAKERS_SUPPORT_URL=mailto:info@wvf-ny.org

# --- Host-side pilot scripts (never used by the website) -------------------
# local | staging | production. Demo users are refused unless this is "local".
# Any value other than "local" also requires config/deployment-gate.json to be passed.
HUMHUB_PILOT_ENV=local
HUMHUB_API_BASE_URL=https://localhost
# Bearer token created in Administration > Modules > REST API. Server-side only.
HUMHUB_API_TOKEN=
# 1 only for the local self-signed certificate.
HUMHUB_TLS_INSECURE=1

# --- Local admin bootstrap (scripts/bootstrap-local.sh only) ---------------
HUMHUB_ADMIN_USERNAME=pilot-admin
HUMHUB_ADMIN_EMAIL=pilot-admin@example.com
HUMHUB_ADMIN_PASSWORD=

# --- Synthetic demo users (local only) -------------------------------------
# One shared password for the fictional example.com demo accounts.
HUMHUB_DEMO_PASSWORD=
